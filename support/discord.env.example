# Discord — append to .env (gitignored). Replace bracketed values.
# The non-secret IDs are also recorded in support/DISCORD_SETUP.md.

# --- Secrets: never commit -------------------------------------------------
BUILD_WEBHOOK=<webhook url from Server Settings -> Integrations -> Webhooks>
DISCORD_BOT_TOKEN=<Developer Portal -> Bot -> Reset Token; shown once>

# --- Identifiers: not secret ----------------------------------------------
